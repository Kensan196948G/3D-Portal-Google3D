# server/.env の見本（実際の値は server/.env に書き、chmod 600。リポジトリには入れない）
DATABASE_URL=postgresql://mirai_portal@127.0.0.1:5432/mirai_portal
TEST_DATABASE_URL=postgresql://mirai_portal@127.0.0.1:5432/mirai_portal_test
# DB のパスワード（URL に書く代わりに。psycopg が読む）
PGPASSWORD=
# Google Map Tiles API のキー（HTTPリファラ制限・Map Tiles API のみに制限したもの）
GOOGLE_MAP_TILES_KEY=
# セッション（時間）と Cookie の Secure 属性（https で配信するときだけ 1）
SESSION_HOURS=12
COOKIE_SECURE=0
# AI による文章化（任意。既定は無効）
AI_ENABLED=0
ANTHROPIC_API_KEY=
# AIS 受信機・サービスからの取り込み口（任意。空なら無効）
AIS_INGEST_TOKEN=
# desknet's NEO・メールの秘密（任意。設定のみで送信はしない）
NEO_API_TOKEN=
SMTP_PASSWORD=
# 毎朝の定時処理（日次の記録）の専用アカウント：python3 -m server.manage create-service-account が書く（手で書かない）
# SNAPSHOT_EMAIL=snapshot-job@portal.invalid
# SNAPSHOT_PASSWORD=
